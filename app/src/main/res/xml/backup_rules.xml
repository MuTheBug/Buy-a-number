<?xml version="1.0" encoding="utf-8"?>
<!-- The API key is sealed by a hardware-backed Keystore key that never leaves
     the device, so nothing in this app is safe or useful to back up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
